USDA_API_KEY=
# Set an absolute path on persistent storage in production.
# FITTRACK_DB_PATH=/data/fittrack.sqlite3
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# HTTPS production default: 1. Set 0 only for local HTTP development.
FITTRACK_COOKIE_SECURE=1
# Consistent local backups on startup and every 24h; retain seven.
FITTRACK_AUTO_BACKUP=1
# FITTRACK_BACKUP_DIR=/data/private-backups

# Optional reliable background reminders. Generate one VAPID key pair and keep
# the private value secret. VAPID_SUBJECT is a mailto: address or HTTPS URL.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# For a single-instance deployment with persistent storage, FitTrack can instead
# create and reuse a private key file. Never enable this on ephemeral storage.
# FITTRACK_AUTO_VAPID=1
# FITTRACK_VAPID_KEY_FILE=/data/vapid.json
# FITTRACK_VAPID_SUBJECT=https://your-public-project-or-contact-page.example
# Set 0 when a separate worker instance owns reminder delivery.
FITTRACK_PUSH_WORKER=1

# Public HTTPS origin when behind a proxy (Render is detected automatically).
# FITTRACK_PUBLIC_ORIGIN=https://your-app.example
