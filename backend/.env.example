USDA_API_KEY=
# Set an absolute path on persistent storage in production.
# FITTRACK_DB_PATH=/data/fittrack.sqlite3
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# HTTPS production default: 1. Set 0 only for local HTTP development.
FITTRACK_COOKIE_SECURE=1
# Consistent local backups on startup and every 24h; retain seven.
FITTRACK_AUTO_BACKUP=1
# FITTRACK_BACKUP_DIR=/data/private-backups
