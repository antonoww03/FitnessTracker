USDA_API_KEY=
# Set an absolute path on persistent storage in production.
# FITTRACK_DB_PATH=/data/fittrack.sqlite3
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# HTTPS production default: 1. Set 0 only for local HTTP development.
FITTRACK_COOKIE_SECURE=1
# Consistent local backups on startup and every 24h; retain seven.
FITTRACK_AUTO_BACKUP=1
# FITTRACK_BACKUP_DIR=/data/private-backups

# Optional reliable background reminders. Generate one VAPID key pair and keep
# the private value secret. VAPID_SUBJECT is a mailto: address or HTTPS URL.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# Set 0 when a separate worker instance owns reminder delivery.
FITTRACK_PUSH_WORKER=1
